# Google Gemini API
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Upload safeguards (defaults shown)
MAX_PDF_FILE_SIZE_MB=20
MAX_PDF_PAGES=500
MAX_BATCH_FILES=5
MAX_BATCH_SIZE_MB=50
MAX_CHUNKS_PER_BATCH=5000

# Set true for a public, read-only demo with curated non-sensitive documents.
# This disables document upload and deletion; it is not user authentication.
DOCUMIND_DEMO_MODE=false

# Console logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL
DOCUMIND_LOG_LEVEL=INFO
